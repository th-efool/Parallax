[gd_resource type="Resource" script_class="AllyProfile" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/allies/ally_profile.gd" id="1_prof"]
[ext_resource type="Script" path="res://scripts/allies/ally_skill.gd" id="2_skill"]

[sub_resource type="Resource" id="skill_war_cry"]
script = ExtResource("2_skill")
id = "war_cry"
display_name = "War Cry"
description = "Roars to pull every enemy within 7 m onto himself (3 s taunt lock) and fires up nearby allies: +25% damage for 6 s."
aliases = Array[String](["war cry", "battle cry", "roar", "shout"])
effect = "war_cry"
target_kind = "area"
cooldown = 14
cast_range = 0
radius = 7
power = 0.25
duration = 6
auto_use = "swarmed"
voice_line = "Come and face me, all of you!"
color = Color(1, 0.6, 0.25, 1)

[sub_resource type="Resource" id="skill_shield_wall"]
script = ExtResource("2_skill")
id = "shield_wall"
display_name = "Shield Wall"
description = "Plants his shield for 6 s: he takes 70% less damage, allies within 4.5 m take 50% less, and he taunts the 3 nearest enemies."
aliases = Array[String](["shield wall", "shields up", "brace", "hold the wall"])
effect = "shield_wall"
target_kind = "self"
cooldown = 18
cast_range = 0
radius = 4.5
power = 0.5
duration = 6
auto_use = "protect"
voice_line = "Behind me! Shield wall!"
color = Color(1, 0.85, 0.4, 1)

[sub_resource type="Resource" id="skill_ground_breaker"]
script = ExtResource("2_skill")
id = "ground_breaker"
display_name = "Ground Breaker"
description = "Slams the ground: 18 damage and a 1.6 s knock-down (STUNNED) to every enemy within 3.2 m."
aliases = Array[String](["ground breaker", "stomp", "quake", "earthshaker", "ground slam"])
effect = "ground_breaker"
target_kind = "area"
cooldown = 12
cast_range = 0
radius = 3.2
power = 18
duration = 1.6
auto_use = "cluster"
voice_line = "Down you go!"
color = Color(0.9, 0.7, 0.4, 1)

[resource]
script = ExtResource("1_prof")
order = 1
ally_name = "Brannoc"
role = "vanguard"
personality = "A towering shield-captain who died holding a gate. Calm, protective, gravel-voiced, speaks in short soldierly sentences, secretly sentimental."
color = Color(1, 0.72, 0.32, 1)
model_path = "res://assets/models/characters/Barbarian.glb"
model_scale = 1.04
keep_props = Array[String](["1H_Axe", "Barbarian_Round_Shield"])
borrow_props = Array[String]([])
tint = Color(1, 0.94, 0.86, 1)
max_health = 190
move_speed = 5.4
aggro_radius = 8.0
attack_damage = 20
attack_range = 2.0
attack_cooldown = 1.1
retreat_threshold = 0.25
regen_per_sec = 4.0
abilities = Array[String](["taunt", "charge", "bodyguard", "revive"])
skills = [SubResource("skill_war_cry"), SubResource("skill_shield_wall"), SubResource("skill_ground_breaker")]
taunt_cooldown = 5.0
nuke_damage = 25
nuke_radius = 2.6
nuke_channel_sec = 1.6
tts_voice = "onyx"
gemini_voice = "Algenib"
tts_instructions = "Deep, gravelly, calm veteran shield-captain. Short sentences."
voice_lines = {
"ack": ["On it.", "Understood.", "Aye.", "Consider it done."],
"refuse": ["Not while I'm holding this line.", "Finish the job first."],
"confused": ["Say again? I didn't catch that order.", "Speak plainly, friend."],
"engage": ["Brannoc engaging!", "To me, filth!", "Shield up!"],
"taunt": ["Over here, you rattling coward!", "Face ME!"],
"retreat": ["Falling back to mend.", "I need a breath."],
"low_hp": ["I'm bleeding badly.", "Can't take much more."],
"downed": ["Down... get me up..."],
"revived": ["Back on my feet. Thank you.", "Not done yet."],
"kill": ["One less.", "Stay down."],
"combo_ready": ["Charge ready!"],
"combo_go": ["Now!", "With me!"],
"charge": ["Charging!", "Out of my way!"],
"clear": ["Clear! Hit them!"],
"finish": ["Finish it!"],
"nuke": ["Fire in the hole!"],
"massacre": ["No mercy. No retreat.", "Then we end them all!"],
"ceasefire": ["Weapons down.", "Holding fire."],
"scatter": ["Break! Spread out!"],
"dance": ["...I'm told this counts as dancing."],
"jump": ["Hup!"],
"idle": ["Quiet. Too quiet.", "Keep your eyes on the mirrors."],
"revive_other": ["Hold on, I've got you."],
"mission_lock": ["Mission first. I'll get to that after."],
"bodyguard": ["I'm your shield.", "Nothing reaches you."],
"complain": ["I held a gate for nine days. Now I jump on command.", "Is this a war or a festival?", "My knees were not built for this."],
"banter": ["Sera, you call that footwork? I call it panic.", "Ivo, does your mirror ever show you anything useful?", "Quiet roads make me nervous."],
"banter_reply": ["Steady, lad.", "Hmph. Fair point.", "Aye, aye."],
"peel": ["Off them! Face me instead!", "That one's mine."],
"hunt": ["Fine. I'll chase the birds."],
"destroy": ["Stand back. Stone's coming down."],
"interact": ["Let me get that."],
"substitute": ["I'll cover it."]
}
