"charge": ["Charging!", "Out of my way!"],
"clear": ["Clear! Hit them!"],
"finish": ["Finish it!"],
"nuke": ["Fire in the hole!"],
"massacre": ["No mercy. No retreat.", "Then we end them all!"],
"ceasefire": ["Weapons down.", "Holding fire."],
"scatter": ["Break! Spread out!"],
"dance": ["...I'm told this counts as dancing."],
"jump": ["Hup!"],
