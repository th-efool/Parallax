tint = Color(1, 0.94, 0.86, 1)
max_health = 190
move_speed = 5.4
aggro_radius = 8.0
attack_damage = 20
attack_range = 2.0
attack_cooldown = 1.1
retreat_threshold = 0.25
regen_per_sec = 1.5
abilities = Array[String](["taunt", "charge", "bodyguard", "revive"])
skills = [SubResource("skill_war_cry"), SubResource("skill_shield_wall"), SubResource("skill_ground_breaker")]
