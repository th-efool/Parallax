gemini_voice = "Iapetus"
tts_instructions = "Precise, refined scholar-mage. Slightly pompous, articulate."
voice_lines = {
"ack": ["Certainly.", "As you wish.", "A sound plan."],
"refuse": ["I am mid-incantation, kindly wait.", "One spell at a time, please."],
"confused": ["I'm afraid that instruction is beyond my grimoire.", "Could you rephrase that?"],
"engage": ["Commencing demonstration.", "Mirror, lend me your edge."],
"taunt": ["You there! Yes, you, ghastly thing!"],
"retreat": ["Retiring to a safer vantage.", "Withdrawing to recompose."],
"low_hp": ["My wards are failing!", "I'm rather badly hurt."],
"downed": ["Most... undignified..."],
"revived": ["Ah. Restored. Splendid.", "My thanks."],
"kill": ["Q.E.D.", "Elegant."],
"combo_ready": ["Channeling! Keep them clustered!", "The circle is ready."],
"combo_go": ["Release!", "Behold!"],
"sigil": ["Sigil laid. Bring them to me.", "The trap is set. Lure them in."],
"detonate": ["Release!", "Detonating!"],
"clear": ["Clear the circle!"],
"finish": ["Allow me."],
"charge": ["Ahem. Charging."],
"massacre": ["Unrestrained? How delightfully reckless.", "Full power, then."],
"ceasefire": ["Dispelling.", "Holding my fire."],
"scatter": ["Dispersing!"],
"dance": ["A minuet, then. Observe."],
"jump": ["Ahem. Hup."],
"idle": ["These mirrors hum in B-flat.", "Fascinating architecture."],
"revive_other": ["Stay still, I'm mending you."],
"mission_lock": ["Noted, after this incantation."],
"nuke": ["Stand clear!", "Shards, fall!"],
"complain": ["This is not what the Academy trained me for.", "I shall document this indignity.", "Must I? Very well."],
"banter": ["Did you know these mirrors hum in B-flat?", "Brannoc, your shield is scientifically fascinating.", "Sera, please stop licking the crystals."],
"banter_reply": ["Indeed.", "How... illuminating.", "Noted."],
"peel": ["Away from them, fiend!"],
"hunt": ["For research purposes, naturally."],
"destroy": ["A controlled demolition, then."],
"interact": ["Allow me to operate the mechanism."],
"substitute": ["I shall improvise."]
