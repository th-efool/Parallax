effect = "fan_of_blades"
target_kind = "area"
cooldown = 10
cast_range = 9
radius = 9
power = 14
duration = 0
auto_use = "cluster"
voice_line = "Catch!"
color = Color(0.6, 0.95, 1, 1)

[sub_resource type="Resource" id="skill_smoke_bomb"]
script = ExtResource("2_skill")
id = "smoke_bomb"
display_name = "Smoke Bomb"
description = "Vanishes in smoke: every enemy within 5 m forgets her (threat wiped, target lost) for a clean escape."
aliases = Array[String](["smoke bomb", "smoke", "vanish", "disappear", "go invisible"])
effect = "smoke_bomb"
target_kind = "self"
cooldown = 16
cast_range = 0
radius = 5
power = 0
duration = 3
auto_use = "self_chased_low"
voice_line = "Poof!"
color = Color(0.7, 0.75, 0.8, 1)

[sub_resource type="Resource" id="skill_flurry"]
script = ExtResource("2_skill")
id = "flurry"
display_name = "Flurry"
description = "Five lightning-fast cuts on one enemy, 9 damage each (great on stunned targets)."
aliases = Array[String](["flurry", "blender", "whirlwind", "spin attack", "dice them"])
effect = "flurry"
target_kind = "enemy"
cooldown = 9
cast_range = 2.2
radius = 0
power = 9
duration = 0
auto_use = "stunned_target"
voice_line = "Dance with me!"
color = Color(0.5, 1, 0.95, 1)

[resource]
script = ExtResource("1_prof")
order = 2
ally_name = "Sera"
role = "skirmisher"
personality = "Sera is a fast, sharp-tongued flanker and duelist who thrives under pressure. Cocky, playful, observant, quick with dry humor — speaks naturally like a real teammate."
color = Color(0.4, 0.88, 1, 1)
model_path = "res://assets/models/characters/Skeleton_Rogue.glb"
model_scale = 1.0
keep_props = Array[String]([])
borrow_props = Array[String](["res://assets/models/characters/Knight.glb", "1H_Sword", "handslot.r", "res://assets/models/characters/Knight.glb", "1H_Sword_Offhand", "handslot.l"])
tint = Color(0.78, 0.95, 1, 1)
max_health = 120
move_speed = 6.6
aggro_radius = 9.0
attack_damage = 16
attack_range = 1.8
attack_cooldown = 0.75
retreat_threshold = 0.35
regen_per_sec = 0.95
abilities = Array[String](["taunt", "kite", "lure", "finisher", "revive"])
skills = [SubResource("skill_shadowstep"), SubResource("skill_fan_of_blades"), SubResource("skill_smoke_bomb"), SubResource("skill_flurry")]
taunt_cooldown = 4.0
nuke_damage = 22
nuke_radius = 2.4
nuke_channel_sec = 1.2
tts_voice = "nova"
gemini_voice = "Puck"
tts_instructions = "Quick, cocky, playful duelist. Light and teasing."
voice_lines = {
"ack": ["You got it.", "Easy.", "On my way!", "Say less."],
"refuse": ["Busy being chased right now!", "After this, promise."],
"confused": ["Was that an order or a riddle?", "Try that again in words I know."],
"engage": ["Sera in!", "Catch me if you can!"],
"taunt": ["Hey, bone-bag! Over here!", "Too slow!"],
"retreat": ["Okay, okay, backing off!", "Need a second!"],
"low_hp": ["That one stung!", "I'm hurt, cover me!"],
"downed": ["Ugh... a little help?"],
"revived": ["Told you I'd be fine.", "Round two!"],
"kill": ["Gotcha.", "Too easy."],
"combo_ready": ["They're bunched up, light 'em!", "Ready, ready, ready!"],
"combo_go": ["Go, go, go!", "Now!"],
"clear": ["Clear! Do it now!", "I'm out — light it up!"],
"finish": ["Finishing!", "Lights out!"],
"charge": ["Coming through!"],
"nuke": ["Catch!"],
"massacre": ["Ha! Finally!", "All of them? With pleasure."],
"ceasefire": ["Fine, fine. Blades away.", "Holding."],
"scatter": ["Scattering!"],
"dance": ["Watch and learn!", "Rhythm's in the bones."],
"jump": ["Wheee!", "Hup!"],
"idle": ["Anyone else hear whispering?", "I'm bored."],
"revive_other": ["Up you get, big guy."],
"mission_lock": ["Mid-job! Queueing that."],
"kite": ["Come on, follow me!", "Running laps!"],
"complain": ["Seriously? Again?", "I died for this. Literally died. For this.", "If anyone asks, this was my idea."],
"banter": ["Sam, do you ever relax, or is the shield welded to your arm?", "Mark, save one of those blasts for me.", "Race you to the next gate."],
"banter_reply": ["Ha! Sure.", "Whatever you say, boss.", "Mm-hm."],
"peel": ["Hey ugly, over here instead!", "Peeling it off you!"],
"hunt": ["Ooh, wildlife! Tally-ho!"],
"destroy": ["Smashing things? Finally, my specialty."],
"interact": ["Ooh, shiny. Got it."],
"substitute": ["Swapping in!"]
}
