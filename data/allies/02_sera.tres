[ext_resource type="Script" path="res://scripts/allies/ally_skill.gd" id="2_skill"]

[sub_resource type="Resource" id="skill_shadowstep"]
script = ExtResource("2_skill")
id = "shadowstep"
display_name = "Shadowstep"
description = "Blinks behind an enemy within 12 m and stabs it in the back for 38 (backstab multipliers apply)."
aliases = Array[String](["shadowstep", "shadow step", "blink behind", "teleport behind", "backstab"])
effect = "shadowstep"
target_kind = "enemy"
cooldown = 8
cast_range = 12
radius = 0
power = 38
duration = 0
auto_use = "engaged"
voice_line = "Behind you."
color = Color(0.4, 0.9, 1, 1)

[sub_resource type="Resource" id="skill_fan_of_blades"]
script = ExtResource("2_skill")
id = "fan_of_blades"
display_name = "Fan of Blades"
description = "Throws knives at up to 3 enemies within 9 m for 14 damage each."
